#!/usr/bin/env bash
# push 前校验被推送的分支名是否符合 <type>/<负责人>_<说明>_<日期>。
# 放行长期/自动分支；跳过（不推荐）：git push --no-verify
set -euo pipefail
zero="0000000000000000000000000000000000000000"
pattern='^(feat|fix|docs|refactor|perf|test|chore|ci|style)/[a-z][a-z0-9]*_.+_([0-9]{4}|[0-9]{8})$'
exempt='^(master|main|dev|release/.+)$'
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # 跳过删除分支
  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
    *) continue ;;                                  # 非分支引用放行
  esac
  printf '%s' "$branch" | grep -Eq "$exempt" && continue
  if ! printf '%s' "$branch" | grep -Eq "$pattern"; then
    echo "❌ 分支名不符合规范，已拒绝 push：$branch" >&2
    fail=1
  fi
done
if [ "$fail" = "1" ]; then
  echo "  要求：<type>/<负责人>_<说明>_<日期>，例 fix/meng_es-npe_0701" >&2
  echo "  跳过（不推荐）：git push --no-verify" >&2
  exit 1
fi
exit 0
