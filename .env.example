# InkTime 相册配置文件示例
# 将此文件复制为 .env 并修改配置。不得把填写真实密钥后的 .env 提交到仓库。
#
# 生产启动前必须同时完成：
# 1. 生成随机 SECRET_KEY；
# 2. 设置 SESSION_COOKIE_SECURE=True，并在前方部署 HTTPS；
# 3. 将 DOWNLOAD_KEY 替换为随机值并同步 ESP32 固件；
# 4. 确认 DB_PATH、IMAGE_DIR、BIN_OUTPUT_DIR 都是运行账号可访问的预期路径。

# 项目名称（用于网站显示）。值含空格必须加引号，否则 source .env 会报错
PROJECT_NAME="InkTime 相册"

# 照片库路径（你自己的相册目录）。Web 和工作进程必须有读写权限，用于
# uploads、.upload-staging、.trash、恢复和过期清理。Docker 部署必须填写宿主机绝对路径，
# 容器会以读写方式挂载到相同绝对路径，以保持数据库中的照片路径可用。
# 支持多个目录，用分号分隔，第一个是主目录（上传与暂存只写主目录，其余只读扫描）：
#   IMAGE_DIR=/home/me/pic;/mnt/nas/album;/mnt/usb/photos
# 多目录限制：目录之间不能互相嵌套（含通过符号链接指向另一个目录内部），
# 每个目录都必须存在且可读，否则后台保存会被拒绝。每个目录各自生成自己的 .trash，
# 因为软删除用硬链接实现、无法跨文件系统。Docker 多目录需要在 compose 里逐个挂载。
IMAGE_DIR=./data/photos

# 数据库路径（建议保持默认）
DB_PATH=./data/photos.db

# VLM 模型接口（如 LM Studio）
API_URL=http://127.0.0.1:1234/v1/chat/completions
MODEL_NAME=qwen3-vl-32b-instruct
API_KEY=

# 每次最多处理多少张的图片
BATCH_LIMIT=None

# 请求超时时间（秒）
TIMEOUT=600

# ESP32 下载路径密钥。production 必须填写至少 24 个字符且不能使用示例值；可用：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# 修改后请同步修改 esp32/ink-display-7C-photo/ink-display-7C-photo.ino 固件中的 DAILY_PHOTO_PATH_PREFIX 字段。
DOWNLOAD_KEY=

# Flask 静态服务
FLASK_HOST=0.0.0.0
FLASK_PORT=5005
# 是否开启照片库 WebUI（前期检验提示词选片效果时使用，跑通后建议关闭）
ENABLE_REVIEW_WEBUI=True

# 离线中文城市名索引，使用 geonames 数据制作
WORLD_CITIES_CSV=./data/world_cities_zh.csv

# 网格大小（纬度/经度度数）；越大越快但精度略差。1.0 对大多数场景够用。
CITY_GRID_DEG=1.0

# 你的"常驻常驻"坐标（用于判断是否为旅行期间照片，从而对评分进行小幅加成）
# 照片 GPS 距离常驻地超过 HOME_RADIUS_KM，则视为"异地"
# 默认值给了深圳市中心附近（不改也能保持原行为的大致效果）
HOME_LAT=22.543096
HOME_LON=114.057865
HOME_RADIUS_KM=60.0

# 最大接受距离（公里），超出则认为"不在任何城市附近"
CITY_MAX_DISTANCE_KM=100.0

# 墨水屏渲染 BIN 文件输出目录
BIN_OUTPUT_DIR=./data/output

# 自定义字体路径（为空则退回默认字体）
FONT_PATH=

# 每日选片"精彩度"阈值
MEMORY_THRESHOLD=70.0

# 每日挑选的照片数量
DAILY_PHOTO_QUANTITY=5

# 「历史上的今天」照片不足 DAILY_PHOTO_QUANTITY 张时，是否从全局高分照片补足。
# 相册照片较少时建议 True，否则当天会少出几张 bin，
# 而 ESP32 随机取 photo_{0..4}.bin 时缺失槽位会读到前几天的旧文件
FILL_FROM_GLOBAL=True

# 送模型前把图片长边压到该值，降低 token 消耗与超时风险。云端 API 建议 1280~1568
VLM_MAX_LONG_EDGE=1568

# 是否开放 /files/ 目录浏览接口（会暴露文件系统结构，建议保持 False）
ENABLE_FILE_BROWSER=False

# ==================== 展示页（/display）====================

# 自动切换模式：
#   interval — 固定间隔，间隔由 DISPLAY_ROTATE_INTERVAL_SEC 决定
#   hourly   — 每到整点切换（10:00、11:00…），与真实时钟对齐
#   minutely — 每到整分切换，用于快速验证对齐逻辑
#   daily    — 每天 00:00 切换一次
#   off      — 不自动切换，仅手动
DISPLAY_ROTATE_MODE=interval

# interval 模式下的切换间隔（秒），最小 1
DISPLAY_ROTATE_INTERVAL_SEC=60

# 展示页自动轮播的生效时间段。留空表示全天生效（与旧行为一致）。
# 格式为分号分隔的「星期@HH:MM-HH:MM」，星期前缀可省略表示每天：
#   DISPLAY_ACTIVE_WINDOWS=07:00-09:00;18:00-23:00
#   DISPLAY_ACTIVE_WINDOWS=Mon-Fri@18:00-23:00;Sat,Sun@09:00-23:00
# 星期写 Mon 到 Sun（大小写不敏感）或 1 到 7（1 为周一），范围用 -，列表用 ,。
# 跨零点自动拆分且后半段归属次日，例如 Fri@22:00-01:30 表示周五夜到周六凌晨。
# 区间左闭右开；判定使用服务器本地时间，与展示设备的时钟无关。
# 非生效时间段内不切换照片、不累加展示次数，因此夜间不会白白消耗照片
DISPLAY_ACTIVE_WINDOWS=

# 非生效时间段的画面：
#   freeze — 停在生效时间段的最后一张（默认）
#   photo  — 显示 DISPLAY_IDLE_PHOTO_ID 指定的照片
#   rest   — 显示 DISPLAY_REST_TEXT 文案
DISPLAY_IDLE_MODE=freeze

# photo 模式使用的照片编号，0 表示未指定。
# 照片不存在或已移入回收站时自动回退为 freeze
DISPLAY_IDLE_PHOTO_ID=0

# rest 模式显示的文案
DISPLAY_REST_TEXT=休息中

# 是否请求屏幕常亮（Screen Wake Lock），避免系统空闲息屏/锁屏打断长时间播放。
# 该 API 要求安全上下文：用 http://127.0.0.1:<端口>/display 或 HTTPS 访问才可用，
# 通过局域网 IP 的 http 访问会被浏览器禁用。
# 局域网访问场景可改用 scripts/display_kiosk.sh，它走系统 idle inhibit，无此限制
DISPLAY_KEEP_AWAKE=True

# 静置多少秒后自动隐藏操作界面（右上角指示器、左右切换提示、鼠标光标），
# 鼠标移动/按键/触摸时立即恢复。设为 0 表示不自动隐藏。
# 底部的文案/日期/地点属于照片内容，不受此项影响
DISPLAY_UI_HIDE_DELAY_SEC=3

# 展示页模板：
#   classic   — 纯照片全屏（原有布局）
#   dashboard — 左侧照片 + 右侧信息栏（时间/日期/农历节气/历史上的今天）
# 也可用 URL 参数临时预览：/display?template=dashboard
DISPLAY_TEMPLATE=classic

# 「历史上的今天」展示条数
ONTHISDAY_COUNT=2
# 筛选策略：
#   recent  — 纯按年份降序取最近的（维基选材偏灾难，实际观感一般）
#   curated — 过滤负面事件（灾难/战争/死亡等）+ 限制年份下限 + 周年加分
#   ai      — 交给大模型筛选（尚未实现，当前等同 curated）
ONTHISDAY_STRATEGY=curated
# curated 策略的年份下限，太久远的事件共鸣低
ONTHISDAY_MIN_YEAR=1900
# 面板 AI 筛选使用的模型。留空则回退 MODEL_NAME（那是视觉模型，用于文本筛选偏浪费）
# 实测 tongyi/qwen3-vl-flash 最快（0.55s / 16 tokens）
PANEL_AI_MODEL=tongyi/qwen3-vl-flash

# ==================== 展示页选片 ====================
# 候选池分数下限（memory_score）。只展示达标的照片，0 表示全部
DISPLAY_MIN_SCORE=70
# 从未展示过的照片在同一轮内的选中权重倍数。1 表示完全公平。
# 实测 200 张池子：权重 1 时新照片首次出现在第 96 次左右，权重 3 约第 35 次，权重 8 约第 11 次。
# 注意不能靠「让新照片展示次数更低」来提前——那会导致新照片连续霸屏
DISPLAY_NEW_PHOTO_WEIGHT=3

# ==================== 管理员登录与会话安全 ====================
# 本地默认 development；systemd 和 Docker 部署文件会强制 APP_ENV=production。
# APP_ENV 只允许 development、testing、production，其他值会拒绝启动。
APP_ENV=development
# production 必须填写随机 SECRET_KEY，可用：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
# production 必须为 True，显式设置 False 也会拒绝启动；本地 development 可保持 False。
SESSION_COOKIE_SECURE=False
# 永久会话有效期与 CSRF token 有效期，单位：秒
PERMANENT_SESSION_LIFETIME=28800
WTF_CSRF_TIME_LIMIT=3600
# 同一用户名与直接连接客户端地址组合的数据库共享连续失败阈值和窗口
# 用户名和地址只以 SECRET_KEY 派生的 HMAC-SHA256 键落库，不读取 X-Forwarded-For。
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=300

# ==================== 上传与后台任务 ====================
# 上传正式路径固定为 IMAGE_DIR/uploads/YYYY/MM，暂存目录为 IMAGE_DIR/.upload-staging。
UPLOAD_MAX_FILES=10
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=80000000
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_RENEW_SECONDS=30
JOB_POLL_SECONDS=2

# 回收站默认保留天数，允许 1 到 3650。
TRASH_RETENTION_DAYS=30
