# InkTime 相册高级配置覆盖示例
# 家庭局域网基础 Docker Compose 无需复制本文件即可启动；默认使用：
#   /app/data/photos、/app/data/photos.db、/app/data/output
# 宿主仓库的 data/ 会整体持久化到 /app/data。
# 仅在本地运行、接入模型、使用外部照片库或部署公网/生产环境时复制为 .env。
# 不得把填写真实密钥后的 .env 提交到仓库。
#
# 公网/生产覆盖必须同时使用 APP_ENV=production、HTTPS 与 SESSION_COOKIE_SECURE=True。
# SECRET_KEY、DOWNLOAD_KEY 和 INITIAL_SETUP_TOKEN 都是可选的高级安全覆盖，不是家庭局域网零配置启动必填项。

# 项目名称（用于网站显示）。值含空格必须加引号，否则 source .env 会报错
PROJECT_NAME="InkTime 相册"

# 照片库路径。基础 Compose 固定为 /app/data/photos，无需宿主绝对路径配置。
# 后台可修改 IMAGE_DIR，但只能选择容器已经挂载、存在且可读的目录，不能动态增加挂载。
# 外部照片库必须先用 Compose override 显式挂载到所有消费者，再填写一致的容器内绝对路径；
# 宿主路径不要求与容器路径字面相同。支持分号分隔多个目录，第一个是主目录：
#   IMAGE_DIR=/photos/main;/photos/nas;/photos/usb
# 目录之间不能互相嵌套，每个目录各自生成 .trash。Web 和工作进程需要读写权限。
IMAGE_DIR=./data/photos

# 数据库路径（基础 Compose 固定为 /app/data/photos.db）
DB_PATH=./data/photos.db

# 容器启动时是否自动把已有数据库补齐到当前代码要求的结构版本，默认关闭。
# 关闭时已有数据库落后即拒绝启动，必须按备份、演练、显式迁移的受控流程升级。
# 开启后容器入口会在迁移前强制创建一致性备份，备份失败则中止升级并启动失败。
# 只覆盖「历史干净、仅落后若干版本」的情形；未知版本、分叉历史、零字节或损坏
# 的数据库一律仍然拒绝。注意它会让回滚旧镜像必须同时恢复对应的数据库备份。
# 需要在 inktime-schema、inktime-server、inktime-worker 上取一致的值，
# 其中 inktime-schema 最先执行门禁，漏配会导致整组仍然启动失败。
# 真值为 1/true/yes/on（不区分大小写）。
AUTO_MIGRATE_ON_START=false

# 自动升级前备份的落地目录，留空表示数据库同级的 backups 子目录。
# 必须位于持久化挂载内，否则容器重建后回滚点会一起消失。
DB_BACKUP_DIR=

# VLM 模型接口（如 LM Studio）
API_URL=http://127.0.0.1:1234/v1/chat/completions
MODEL_NAME=qwen3-vl-32b-instruct
API_KEY=

# 每次最多处理多少张的图片
BATCH_LIMIT=None

# 请求超时时间（秒）
TIMEOUT=600

# ESP32 下载路径密钥（可选高级覆盖）。未显式设置时，应用会在数据库同目录
# 创建或读取 .inktime-download-key，新文件权限为 0600；显式环境变量优先。
# 已有文件损坏、权限不安全或无法读取时会拒绝启动，不会静默重置。
# 删除持久化文件会在下次启动生成新值并改变设备下载地址。
# 显式设置时 production 要求至少 24 个字符，可用：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# 管理员可在 /admin/settings 复制包含当前密钥的完整 latest.bin 地址。
DOWNLOAD_KEY=

# Flask 静态服务
FLASK_HOST=0.0.0.0
FLASK_PORT=5005
# 是否开启照片库 WebUI（前期检验提示词选片效果时使用，跑通后建议关闭）
ENABLE_REVIEW_WEBUI=True

# 离线中文城市名索引，使用 geonames 数据制作
# 城市索引路径。留空即自动查找：先看 data/world_cities_zh.csv（放一份进去即可
# 覆盖成自己的城市表），没有则用随代码分发的 resources/world_cities_zh.csv。
# 不要把主副本放回 data/：容器会把宿主目录挂到 /app/data，镜像里的同名目录
# 会被整体遮蔽，文件明明打进了镜像却读不到。
WORLD_CITIES_CSV=

# 网格大小（纬度/经度度数）；越大越快但精度略差。1.0 对大多数场景够用。
CITY_GRID_DEG=1.0

# 你的"常驻常驻"坐标（用于判断是否为旅行期间照片，从而对评分进行小幅加成）
# 照片 GPS 距离常驻地超过 HOME_RADIUS_KM，则视为"异地"
# 默认值给了深圳市中心附近（不改也能保持原行为的大致效果）
HOME_LAT=22.543096
HOME_LON=114.057865
HOME_RADIUS_KM=60.0

# 最大接受距离（公里），超出则认为"不在任何城市附近"
CITY_MAX_DISTANCE_KM=100.0

# 墨水屏渲染 BIN 文件输出目录
BIN_OUTPUT_DIR=./data/output

# 自定义字体路径（为空则退回默认字体）
FONT_PATH=

# 每日选片"精彩度"阈值
MEMORY_THRESHOLD=70.0

# 每日挑选的照片数量
DAILY_PHOTO_QUANTITY=5

# 「历史上的今天」照片不足 DAILY_PHOTO_QUANTITY 张时，是否从全局高分照片补足。
# 相册照片较少时建议 True，否则当天会少出几张 bin，
# 而 ESP32 随机取 photo_{0..4}.bin 时缺失槽位会读到前几天的旧文件
FILL_FROM_GLOBAL=True

# 送模型前把图片长边压到该值，降低 token 消耗与超时风险。云端 API 建议 1280~1568
VLM_MAX_LONG_EDGE=1568

# 是否开放 /files/ 目录浏览接口（会暴露文件系统结构，建议保持 False）
ENABLE_FILE_BROWSER=False

# ==================== 展示页（/display）====================

# 自动切换模式：
#   interval — 固定间隔，间隔由 DISPLAY_ROTATE_INTERVAL_SEC 决定
#   hourly   — 每到整点切换（10:00、11:00…），与真实时钟对齐
#   minutely — 每到整分切换，用于快速验证对齐逻辑
#   daily    — 每天 00:00 切换一次
#   off      — 不自动切换，仅手动
DISPLAY_ROTATE_MODE=interval

# interval 模式下的切换间隔（秒），最小 1
DISPLAY_ROTATE_INTERVAL_SEC=60

# 缩略图长边像素上限（照片墙与后台网格）。
# 原值 300 在高清屏上明显模糊：网格单元约 293 px 宽，2 倍屏需要约 586 px 像素。
# 小图不会被放大。改大后浏览器缓存会自动失效，无需清缓存
THUMBNAIL_MAX_EDGE=640

# 缩略图 JPEG 质量，40 到 95
THUMBNAIL_QUALITY=82

# 是否把生成好的缩略图缓存到 data/cache/thumbnails。
# 关闭后每次请求都实时解码原图；缓存键含源文件版本与上面两个参数，
# 改照片或改配置会自动落到新键，不需要手动清理
THUMBNAIL_CACHE_ENABLED=True

# 展示页自动轮播的生效时间段。留空表示全天生效（与旧行为一致）。
# 格式为分号分隔的「星期@HH:MM-HH:MM」，星期前缀可省略表示每天：
#   DISPLAY_ACTIVE_WINDOWS=07:00-09:00;18:00-23:00
#   DISPLAY_ACTIVE_WINDOWS=Mon-Fri@18:00-23:00;Sat,Sun@09:00-23:00
# 星期写 Mon 到 Sun（大小写不敏感）或 1 到 7（1 为周一），范围用 -，列表用 ,。
# 跨零点自动拆分且后半段归属次日，例如 Fri@22:00-01:30 表示周五夜到周六凌晨。
# 区间左闭右开；判定使用服务器本地时间，与展示设备的时钟无关。
# 非生效时间段内不切换照片、不累加展示次数，因此夜间不会白白消耗照片
DISPLAY_ACTIVE_WINDOWS=

# 非生效时间段的画面：
#   freeze — 停在生效时间段的最后一张（默认）
#   photo  — 显示 DISPLAY_IDLE_PHOTO_ID 指定的照片
#   rest   — 显示 DISPLAY_REST_TEXT 文案
DISPLAY_IDLE_MODE=freeze

# photo 模式使用的照片编号，0 表示未指定。
# 照片不存在或已移入回收站时自动回退为 freeze
DISPLAY_IDLE_PHOTO_ID=0

# rest 模式显示的文案
DISPLAY_REST_TEXT=休息中

# ---------- 展示页天气 ----------
# 总开关。关闭时不会向外部天气服务发起任何请求
WEATHER_ENABLED=False

# 数据源。open-meteo 免注册、免 API key，按位置自动选最优预报模型
# （国内位置会用到中国气象局 CMA GRAPES）
WEATHER_PROVIDER=open-meteo

# 天气位置，格式「纬度,经度」。留空则使用下方常驻地坐标 HOME_LAT 与 HOME_LON。
# 注意：坐标会发送给第三方天气服务（Open-Meteo 无需账号，请求是匿名的）。
# 介意的话只填到小数点后一位，约 11 公里精度，对天气预报没有实质影响
WEATHER_LOCATION=

# 展示用地名，留空则不显示。不做地名反查，以免多一次请求和一个外部依赖
WEATHER_LOCATION_NAME=

# 服务端天气缓存分钟数。缓存期内不重复请求外部服务
WEATHER_CACHE_MINUTES=15

# 仪表盘模板是否显示天气块
DISPLAY_WEATHER_SHOW=True

# 沉浸式模板是否在右上角显示极简天气角标。
# 默认关闭：该模板的设计意图是照片占满、干扰最小
DISPLAY_WEATHER_CORNER=False

# 是否请求屏幕常亮（Screen Wake Lock），避免系统空闲息屏/锁屏打断长时间播放。
# 该 API 要求安全上下文：用 http://127.0.0.1:<端口>/display 或 HTTPS 访问才可用，
# 通过局域网 IP 的 http 访问会被浏览器禁用。
# 局域网访问场景可改用 scripts/display_kiosk.sh，它走系统 idle inhibit，无此限制
DISPLAY_KEEP_AWAKE=True

# 静置多少秒后自动隐藏操作界面（右上角指示器、左右切换提示、鼠标光标），
# 鼠标移动/按键/触摸时立即恢复。设为 0 表示不自动隐藏。
# 底部的文案/日期/地点属于照片内容，不受此项影响
DISPLAY_UI_HIDE_DELAY_SEC=3

# 展示页模板：
#   classic   — 纯照片全屏（原有布局）
#   dashboard — 左侧照片 + 右侧信息栏（时间/日期/农历节气/历史上的今天）
# 也可用 URL 参数临时预览：/display?template=dashboard
DISPLAY_TEMPLATE=classic

# 「历史上的今天」展示条数
ONTHISDAY_COUNT=2
# 数据源（可在后台设置页切换，界面显示中文名）：
#   baidu     — 百度百科，国内直连、免密钥，按月返回整月数据，带事件类型
#   60s       — 60s 开源接口，百度数据的二次封装，字段已清洗，作备用
#   wikipedia — 维基百科，国内网络常不可达（NAS 无 IPv6 时尤其明显）
ONTHISDAY_SOURCE=baidu
# 筛选策略：
#   recent  — 纯按年份降序取最近的（选材偏灾难，实际观感一般）
#   curated — 规则精选：按事件类型剔除逝世类 + 过滤负面关键词 + 年份下限 + 周年加分
#   ai      — 交给大模型筛选并改写，失败自动回退 curated
ONTHISDAY_STRATEGY=curated
# curated 策略的年份下限，太久远的事件共鸣低
ONTHISDAY_MIN_YEAR=1900
# 面板 AI 筛选使用的模型。留空则回退 MODEL_NAME（那是视觉模型，用于文本筛选偏浪费）
# 实测 tongyi/qwen3-vl-flash 最快（0.55s / 16 tokens）
PANEL_AI_MODEL=tongyi/qwen3-vl-flash

# ==================== 展示页选片 ====================
# 候选池分数下限（memory_score）。只展示达标的照片，0 表示全部
DISPLAY_MIN_SCORE=70
# 从未展示过的照片在同一轮内的选中权重倍数。1 表示完全公平。
# 实测 200 张池子：权重 1 时新照片首次出现在第 96 次左右，权重 3 约第 35 次，权重 8 约第 11 次。
# 注意不能靠「让新照片展示次数更低」来提前——那会导致新照片连续霸屏
DISPLAY_NEW_PHOTO_WEIGHT=3

# ==================== 管理员登录与会话安全 ====================
# 基础 Docker Compose 默认 development + 普通 HTTP + 非安全 Cookie，只适合可信家庭局域网。
# 公网或生产覆盖必须使用 APP_ENV=production、HTTPS 和 SESSION_COOKIE_SECURE=True。
APP_ENV=development
# 会话签名密钥（可选高级覆盖）。未显式设置时，应用会在数据库同目录创建或读取
# .inktime-secret-key，新文件权限为 0600；显式环境变量优先。文件损坏或权限不安全时拒绝启动。
SECRET_KEY=
# 首次管理员初始化令牌是可选高级覆盖，以下两种来源只能配置一种。
# 两者都为空时，/admin/setup 允许可信局域网内首位访问者创建管理员；公网或不可信网络应配置。
# 配置后必须至少 24 个字符且不能含空白，页面会显示令牌字段并严格校验。
# 初始化完成后删除令牌来源并重启。生成命令：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INITIAL_SETUP_TOKEN=
INITIAL_SETUP_TOKEN_FILE=
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
# production 必须为 True，显式设置 False 也会拒绝启动；基础 Compose 的 development 为 False。
SESSION_COOKIE_SECURE=False
# 永久会话有效期与 CSRF token 有效期，单位：秒
PERMANENT_SESSION_LIFETIME=28800
WTF_CSRF_TIME_LIMIT=3600
# 同一用户名与直接连接客户端地址组合的数据库共享连续失败阈值和窗口
# 用户名和地址只以 SECRET_KEY 派生的 HMAC-SHA256 键落库，不读取 X-Forwarded-For。
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=300

# ==================== 上传与后台任务 ====================
# 上传支持 JPEG、PNG、WebP、HEIC 与手机 HDR 常见的 MPO。
# 不要求扩展名与真实格式一致：微信或浏览器另存常出现「内容是 WebP、文件名叫 .jpg」，
# 落盘时会按检测出的真实格式重命名。HEIC 会转码为 JPEG，因为浏览器与渲染链路都不支持。
# 单文件上限默认 64 MiB（手机原图常有四五十兆），落盘前会压到 UPLOAD_TARGET_BYTES 以内。
# 上传正式路径固定为 IMAGE_DIR/uploads/YYYY/MM，暂存目录为 IMAGE_DIR/.upload-staging。
UPLOAD_MAX_FILES=10
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=80000000
JOB_MAX_ATTEMPTS=3
# 任务失败后重新认领前的等待秒数基数，按尝试次数指数增长（30、60 秒）。
# 设为 0 表示立即重试：上游抖动或限流时，三次尝试会在几秒内烧光，照片直接判失败
JOB_RETRY_BACKOFF_SECONDS=30

JOB_LEASE_SECONDS=120
JOB_RENEW_SECONDS=30
JOB_POLL_SECONDS=2

# 回收站默认保留天数，允许 1 到 3650。
TRASH_RETENTION_DAYS=30
