# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/

# IDE
.idea/
.vscode/
.DS_Store
__MACOSX/

# Static resources
resources/fonts/

# Sensitive config
config.py

# Outputs
output/

# Database
filelist.txt
*.db
# SQLite 运行时文件：WAL 模式的写前日志与共享内存索引，以及 DELETE 模式的回滚日志。
# 它们含未落库的数据、与主库版本强绑定，不能进版本库。
*.db-wal
*.db-shm
*.db-journal

# Logs
logs/

# Runtime
tmp/
data/output/
data/inktime_13in3_6c/

# 运行时密钥：未显式配置 SECRET_KEY / DOWNLOAD_KEY 时由应用在数据库同目录生成。
# 会话密钥进版本库等于任何人都能伪造管理员会话，下载密钥泄露等于设备地址公开。
data/.inktime-secret-key
data/.inktime-download-key
data/.inktime-runtime-secrets.lock

# Others
test/
old/
.env
node_modules/
package-lock.json
data/backups/
# 缩略图磁盘缓存：可随时重建，键名含源文件版本与配置参数
data/cache/