[Unit]
Description=InkTime Database Schema Gate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=meng
Group=meng
WorkingDirectory=/home/work/InkTime
EnvironmentFile=/home/work/InkTime/.env
Environment=PYTHONPATH=/home/work/InkTime
ExecStart=/home/work/InkTime/venv/bin/python scripts/database_admin.py check-schema --database ${DB_PATH}
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
