[Unit]
Description=InkTime Background Worker
Wants=network-online.target
Requires=inktime-schema.service
After=network-online.target inktime-schema.service

[Service]
Type=simple
User=meng
Group=meng
WorkingDirectory=/home/work/InkTime
EnvironmentFile=/home/work/InkTime/.env
Environment=PYTHONPATH=/home/work/InkTime
ExecStart=/home/work/InkTime/venv/bin/python -m src.analysis.run_worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
