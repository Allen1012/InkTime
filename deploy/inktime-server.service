[Unit]
Description=InkTime Web Server
Wants=network-online.target
Requires=inktime-schema.service
After=network-online.target inktime-schema.service

[Service]
Type=simple
User=meng
Group=meng
WorkingDirectory=/home/work/InkTime
EnvironmentFile=/home/work/InkTime/.env
Environment=APP_ENV=production
Environment=PYTHONPATH=/home/work/InkTime
# 不加这行，Python 在非终端环境下 stdout 为块缓冲，脚本里的 print 诊断信息
# 会长期卡在缓冲区、journalctl 里看不到（logging 走 stderr 不受影响）
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/work/InkTime/venv/bin/python -m src.server.run_server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
