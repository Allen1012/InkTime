{
  "name": "inktime",
  "description": "InkTime 开发用 agent：读代码、搜索、跑单测、写临时脚本自动放行；写文件限定在源码与文档目录；提交、推送、部署、装依赖、动数据仍需确认",
  "tools": ["*"],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "introspect",
    "todo_list",
    "goal",
    "knowledge",
    "web_search",
    "subagent",
    "@feishu-mcp/fetch-doc",
    "@feishu-mcp/fetch-file",
    "@feishu-mcp/get-comments",
    "@feishu-mcp/get-user",
    "@feishu-mcp/list-docs",
    "@feishu-mcp/search-doc",
    "@feishu-mcp/search-user"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file:///home/meng/.kiro/steering/**/*.md",
    "skill:///home/meng/.kiro/skills/**/SKILL.md",
    "file://README.md"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "./src/**",
        "./tests/**",
        "./docs/**",
        "./scripts/**",
        "./deploy/**",
        "./esp32/**",
        "./README.md",
        "./.env.example",
        "/tmp/**"
      ],
      "deniedPaths": [
        "./.env",
        "./data/**",
        "./logs/**",
        "./.kiro/**",
        "./venv/**",
        "./.git/**"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "\\./venv/bin/python .*",
        "\\./venv/bin/flask .*",
        "\\./venv/bin/pip (list|show|freeze).*",
        "\\./scripts/[a-z_]+\\.sh.*",
        "python3? (-m |-c |- ).*",
        "cat > /tmp/.*",
        "cat >> /tmp/.*",
        "rm -f /tmp/.*",
        "rm -rf /tmp/[a-zA-Z0-9._-]+.*",
        "(ls|cat|head|tail|wc|find|file|stat|du|df|tree|which|echo|printf|pwd|date|env|sort|uniq|cut|sed -n|awk|diff|realpath|basename|dirname|xxd|md5sum|sha256sum) .*",
        "grep .*",
        "rg .*",
        "pgrep .*",
        "^id$",
        "^set -[eux]+ *;.*",
        "^journalctl .*",
        "^systemctl (list-units|list-unit-files|status|show|cat|is-active|is-enabled|is-failed)\\b.*",
        "git (status|diff|log|show|branch|tag|remote|stash list|ls-files|blame|shortlog|describe|rev-parse|merge-base|config --get).*",
        "git fetch.*",
        "git add .*",
        "git commit .*",
        "git switch .*",
        "git checkout .*",
        "git restore .*",
        "git pull --ff-only.*",
        "kiro-cli (agent|settings|mcp) .*",
        "mkdir -p (data|logs|/tmp)/.*",
        "chmod \\+x \\./scripts/.*",
        "curl -sS? -o /dev/null.*",
        "true",
        "false"
      ],
      "deniedCommands": [
        ".*\\bsudo\\b.*",
        ".*\\bsu -.*",
        ".*rm -rf +/($|[^t].*)",
        ".*rm -rf +/t($|[^m].*|m($|[^p].*|p($|[^/].*)))",
        ".*rm -rf +~.*",
        ".*rm -rf +\\$HOME.*",
        ".*rm -rf +\\.git.*",
        ".*rm -rf +(data|logs|venv|src|tests|docs)\\b.*",
        ".*\\bgit push\\b.*",
        ".*git reset --hard.*",
        ".*git clean .*",
        ".*git rebase.*",
        ".*git commit --amend.*",
        ".*git branch -D.*",
        ".*git filter-branch.*",
        ".*docker (compose )?(down|rm|kill|system prune|volume rm).*",
        ".*docker (compose )?(build|up|push).*",
        ".*\\b(pip|pip3) install.*",
        ".*\\b(npm|yarn|pnpm) (install|add|publish).*",
        ".*\\bapt(-get)? (install|remove|purge).*",
        ".*\\b(dd|mkfs|fdisk|parted)\\b.*",
        ".*chmod +-R +777.*",
        ".*chown -R.*",
        ".*(curl|wget)[^|]*\\|[^|]*\\b(sh|bash|zsh|python3?)\\b.*",
        ".*> *\\./?\\.env( |$).*",
        ".*> *\\./?data/.*",
        ".*\\bsqlite3\\b.*(DROP|DELETE|UPDATE|INSERT|ALTER).*",
        ".*systemctl (start|stop|restart|enable|disable).*",
        ".*\\bkill(all)? -9.*",
        ".*\\bshutdown\\b.*",
        ".*\\breboot\\b.*"
      ]
    },
    "use_aws": {
      "autoAllowReadonly": true
    }
  }
}
